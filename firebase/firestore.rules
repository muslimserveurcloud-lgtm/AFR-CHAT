rules_version = '2';

// Règles de sécurité Firestore — AFR CHAT
// Principe : un utilisateur ne peut jamais lire ou modifier les données privées d'un autre
// utilisateur sans autorisation explicite (participation à une conversation/un groupe, ou
// rôle administrateur attribué via un custom claim Firebase Auth "admin", positionné
// uniquement par la Cloud Function setAdminRole — jamais par le client).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isNotBanned() {
      return isSignedIn() &&
        !(exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == true);
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isSignedIn(); // profil public minimal nécessaire pour la recherche et l'affichage
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && isNotBanned()
        // un utilisateur ne peut jamais s'auto-attribuer les droits admin ou se dé-bannir lui-même
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.isBanned == resource.data.isBanned;
      allow update: if isAdmin(); // les Cloud Functions admin agissent avec les droits Admin SDK (bypass rules) ; ceci couvre aussi un accès direct par un compte à custom claim admin
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- CONVERSATIONS ----------
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }
      function isParticipantOnCreate() {
        return isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      }

      allow read: if isParticipant();
      allow create: if isParticipantOnCreate() && isNotBanned();
      allow update: if isParticipant() && isNotBanned();
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isConversationParticipant() {
          return isSignedIn() && request.auth.uid in parentConversation().participantIds;
        }

        allow read: if isConversationParticipant();
        allow create: if isConversationParticipant() && isNotBanned()
          && request.resource.data.senderId == request.auth.uid;
        // Mise à jour limitée : statut de lecture, réactions, suppression logique uniquement —
        // jamais de modification du texte ou de l'expéditeur d'origine par un tiers.
        allow update: if isConversationParticipant()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.sentAt == resource.data.sentAt;
        allow delete: if false;
      }
    }

    // ---------- GROUPS ----------
    match /groups/{groupId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberUids;
      }
      function isGroupAdmin() {
        return isSignedIn() && request.auth.uid in resource.data.adminUids;
      }

      allow read: if isMember() || isAdmin();
      allow create: if isSignedIn() && isNotBanned()
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid in request.resource.data.adminUids;
      allow update: if (isMember() && isNotBanned()) || isAdmin();
      allow delete: if isGroupAdmin() || isAdmin();
    }

    // ---------- STORIES ----------
    match /stories/{storyId} {
      allow read: if isSignedIn() && resource.data.expiresAt > request.time.toMillis();
      allow create: if isSignedIn() && isNotBanned() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn(); // permet aux autres utilisateurs d'ajouter leur uid à viewerUids
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- CALLS (signalisation WebRTC) ----------
    match /calls/{callId} {
      function isCallParticipant() {
        return isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      }
      allow read: if isCallParticipant();
      allow create: if isSignedIn() && request.resource.data.callerUid == request.auth.uid;
      allow update: if isCallParticipant();
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // ---------- REPORTS (modération) ----------
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}
